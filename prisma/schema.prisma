generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id             String             @id @default(cuid())
  serialNumber   String             @unique @map("serial_number") @db.VarChar(100)
  aliasName      String?            @map("alias_name") @db.VarChar(100)
  ipAddress      String?            @map("ip_address") @db.VarChar(45)
  lastActivityAt DateTime?          @map("last_activity_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  punches        AttendancePunch[]
  commands       DeviceCommand[]
  enrollments    DeviceEnrollment[]

  @@map("devices")
}

enum UserRole {
  ADMIN
  HR
}

enum ImportStatus {
  PREVIEWED
  COMMITTED
  FAILED
}

enum ReportFrequency {
  DAILY
  WEEKLY
}

enum ReportScope {
  ALL
  EMPLOYEE
  DIVISION
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique @db.VarChar(320)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  role         UserRole     @default(HR)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  auditEvents  AuditEvent[]
  importRuns   ImportRun[]
  reportSchedules ReportSchedule[]

  @@map("users")
}

model ReportSchedule {
  id           String          @id @default(cuid())
  name         String          @db.VarChar(200)
  frequency    ReportFrequency
  weekday      Int?
  time         String          @db.VarChar(5)
  recipients   Json
  scope        ReportScope     @default(ALL)
  employeeId   String?         @map("employee_id")
  divisionName String?         @map("division_name") @db.VarChar(200)
  active       Boolean         @default(false)
  createdById  String          @map("created_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deliveries   ReportDelivery[]

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([active, frequency, weekday, time])
  @@map("report_schedules")
}

model ReportDelivery {
  id             String   @id @default(cuid())
  scheduleId     String   @map("schedule_id")
  periodStart    String   @map("period_start") @db.VarChar(10)
  periodEnd      String   @map("period_end") @db.VarChar(10)
  status         String   @db.VarChar(20)
  kind           String   @default("SCHEDULED") @db.VarChar(20)
  recipientCount Int      @map("recipient_count")
  errorMessage   String?  @map("error_message") @db.Text
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime @default(now()) @map("created_at")

  schedule ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, periodStart, periodEnd, kind])
  @@index([scheduleId, createdAt])
  @@map("report_deliveries")
}

model Employee {
  id            String             @id @default(cuid())
  employeeCode  String             @unique @map("employee_code") @db.VarChar(100)
  firstName     String             @map("first_name") @db.VarChar(100)
  lastName      String?            @map("last_name") @db.VarChar(100)
  displayName   String             @map("display_name") @db.VarChar(200)
  gender        String?            @db.VarChar(20)
  divisionCode  String?            @map("division_code") @db.VarChar(100)
  divisionName  String?            @map("division_name") @db.VarChar(200)
  position      String?            @db.VarChar(200)
  email         String?            @db.VarChar(320)
  hireDate      DateTime?          @map("hire_date") @db.Date
  activeDate    DateTime?          @map("active_date") @db.Date
  active        Boolean            @default(true)
  deactivatedAt DateTime?          @map("deactivated_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  enrollments   DeviceEnrollment[]

  @@index([active, displayName])
  @@map("employees")
}

model DeviceEnrollment {
  id               String   @id @default(cuid())
  employeeId       String   @map("employee_id")
  deviceId         String   @map("device_id")
  pin              String   @db.VarChar(50)
  fingerprintCount Int?     @map("fingerprint_count")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([deviceId, pin])
  @@index([employeeId, active])
  @@map("device_enrollments")
}

model ImportRun {
  id          String       @id @default(cuid())
  sourceType  String       @map("source_type") @db.VarChar(50)
  fileName    String       @map("file_name") @db.VarChar(255)
  checksum    String       @db.VarChar(64)
  status      ImportStatus @default(PREVIEWED)
  summary     Json
  rowResults  Json         @map("row_results")
  actorId     String       @map("actor_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  committedAt DateTime?    @map("committed_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([checksum])
  @@map("import_runs")
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(100)
  targetId   String   @map("target_id") @db.VarChar(100)
  summary    Json
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@map("audit_events")
}

model DeviceCommand {
  id          Int       @id @default(autoincrement())
  deviceId    String    @map("device_id")
  command     String    @db.Text
  status      String    @default("pending") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([deviceId, status, id])
  @@map("device_commands")
}

model AttendancePunch {
  id              String   @id @default(cuid())
  deviceId        String   @map("device_id")
  userId          String   @map("user_id") @db.VarChar(50)
  occurredAtLocal String   @map("occurred_at_local") @db.VarChar(19)
  status          Int?
  verify          Int?
  workCode        Int?     @map("work_code")
  rawData         String   @map("raw_data") @db.Text
  receivedAt      DateTime @default(now()) @map("received_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([deviceId, userId, occurredAtLocal])
  @@index([deviceId, occurredAtLocal])
  @@map("attendance_punches")
}
